# Copy this file to .env.development or .env.production and fill in the values.

NODE_ENV=development       # development | production
PORT=3000                  # HTTP port the server listens on

MONGODB_URI=               # e.g. mongodb://localhost:27017/webglow  or  mongodb+srv://...

JWT_ACCESS_SECRET=         # secret used to sign 15-minute access tokens
JWT_REFRESH_SECRET=        # secret used to sign 7-day refresh tokens  (must differ from ACCESS)

FRONTEND_URL=              # e.g. http://localhost:5173  (used for CORS allow-origin)
